#!/usr/bin/env bash
# Local review gate for every commit: format, analysis and tests for each
# Dart/Flutter package affected by the staged changes (including deletions),
# run on a snapshot of the index, not on the working tree.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
source tool/hooks/lib.sh

snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT
git diff --cached --name-only --no-renames -z >"$snapshot/changed-paths"
[ -s "$snapshot/changed-paths" ] || exit 0
# Keep metadata outside the index snapshot to avoid overwriting staged files.
changed="$snapshot/changed-paths"
mkdir "$snapshot/content"
git checkout-index --all --prefix="$snapshot/content/"

if hook_checks_required <"$changed"; then
  check_hook_suite "$snapshot/content" || exit 1
fi

packages="$(
  while IFS= read -r -d '' path; do
    package_of "$snapshot/content" "$path"
  done <"$changed" | sort -u
)"
[ -z "$packages" ] && exit 0

while IFS= read -r pkg; do
  echo "pre-commit: checking $pkg (staged content)"
  check_package "$snapshot/content/$pkg"
done <<<"$packages"
