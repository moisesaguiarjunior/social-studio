      "surfaces": [
        {
          "id": "android",
          "limits": [
            {
              "id": "accepted_formats",
              "status": "published",
              "source": "https://developers.facebook.com/docs/android/sharing-to-reels-instagram",
              "source_updated": "2024-03-18",
              "checked_on": "2026-11-11",
              "binding": "required",
              "value": [
                "h264",
                "h265",
                "mov",
                "mp4",
                "webm"
              ],
              "text": "The accepted-format list mixes codecs and containers: H.264, H.265, MOV, MP4, and WebM."
            },
            {
              "id": "nominal_resolution",
              "status": "published",
              "source": "https://developers.facebook.com/docs/android/sharing-to-reels-instagram",
              "source_updated": "2024-03-18",
              "checked_on": "2026-11-11",
              "binding": "should",
              "text": "Videos should be 1080p. The page does not define 1080p in pixels."
            },
            {
