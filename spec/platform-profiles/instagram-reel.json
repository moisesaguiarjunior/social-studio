          "checked_on": "2026-11-11",
          "binding": "required",
          "value": [
            "mov",
            "mp4"
          ],
          "text": "MOV or MP4 (MPEG-4 Part 14)."
        },
        {
          "id": "fast_start",
          "status": "published",
          "source": "https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/reference/ig-user/media",
          "source_updated": "2026-09-28",
          "checked_on": "2026-11-11",
          "binding": "required",
          "value": "moov atom at the front of the file; no edit lists",
          "text": "v0 records this and does not inspect bytes."
        },
        {
          "id": "video_codecs",
          "status": "published",
          "source": "https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/reference/ig-user/media",
          "source_updated": "2026-09-28",
          "checked_on": "2026-11-11",
          "binding": "required",
          "value": [
            "hevc",
            "h264"
          ],
          "text": "HEVC or H264, progressive scan, closed GOP. HEVC is not renamed to the share hand-off token h265. WebM is not in this list."
