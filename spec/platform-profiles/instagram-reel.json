              "source_updated": "2026-04-06",
              "checked_on": "2026-11-11",
              "binding": "required",
              "value": [
                "h264",
                "h265",
                "webm"
              ],
              "text": "H.264, H.265, and WebM."
            },
            {
              "id": "container",
              "status": "not_published",
              "source": "https://developers.facebook.com/docs/ios/sharing-to-reels-instagram/",
              "source_updated": "2026-04-06",
              "checked_on": "2026-11-11"
