              "status": "published",
              "source": "https://developers.facebook.com/docs/android/sharing-to-reels-instagram",
              "source_updated": "2024-03-18",
              "checked_on": "2026-11-11",
              "binding": "should",
              "text": "Dimensions should be device fullscreen or smaller. The page does not define device fullscreen in pixels."
            },
            {
              "id": "maximum_file_size",
              "status": "not_published",
              "source": "https://developers.facebook.com/docs/android/sharing-to-reels-instagram",
