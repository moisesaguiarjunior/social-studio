{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:social-studio:schema:v0:platform-profile",
  "title": "Platform profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "product_hand_off",
            "publishing_api"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limit"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limit"
          }
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "source",
        "checked_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "not_published"
          ]
        },
        "binding": {
          "enum": [
            "required",
            "recommended",
            "should",
            "can_be"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 8
        },
        "source_updated": {
          "type": "string",
          "minLength": 1
        },
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "not_published"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "binding"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "unit"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "published"
              }
            }
          },
          "then": {
            "required": [
              "binding"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "binding"
            ],
            "properties": {
              "binding": {
                "const": "required"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  }
}
