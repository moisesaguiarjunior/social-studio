{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:social-studio:schema:v0:template",
  "title": "Template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slots",
    "brand_tokens",
    "motion_presets",
    "caption_style",
    "layers",
    "layouts"
  ],
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "cover_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "brand_tokens": {
      "$ref": "#/$defs/brand"
    },
    "motion_presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motion"
      }
    },
    "caption_style": {
      "$ref": "#/$defs/caption_style"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layout"
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "audio",
            "text",
            "video"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "fonts",
        "logo"
      ],
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "zoom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "caption_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "shape",
            "image",
            "video",
            "text",
            "audio",
            "captions",
            "lottie"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "motion": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "enum": [
            "cover"
          ]
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_ms",
              "end_ms",
              "text"
            ],
            "properties": {
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "path_id",
        "canvas"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "$ref": "#/$defs/canvas"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frame_rate"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
