{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:social-studio:schema:v0:render-job",
  "title": "Render job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "template_id",
    "profile_id",
    "path_id",
    "duration_ms",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "path_id": {
      "type": "string",
      "minLength": 1
    },
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "video_codec": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "frame_rate": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slot_value"
      }
    }
  },
  "$defs": {
    "slot_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_id"
          ],
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "at_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
